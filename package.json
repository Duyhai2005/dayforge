{
  "name": "dayforge",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "lint:web": "pnpm --filter @dayforge/frontend lint",
    "lint:api": "uv run --directory backend --locked ruff check app tests migrations ../scripts",
    "format:check:api": "uv run --directory backend --locked black --check app tests migrations ../scripts",
    "lint": "pnpm lint:web && pnpm lint:api && pnpm format:check:api",
    "typecheck:web": "pnpm --filter @dayforge/frontend typecheck",
    "typecheck:api": "uv run --directory backend --locked mypy app",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api",
    "test:api": "uv run --directory backend --locked python ../scripts/test_backend.py",
    "test:api:mysql": "uv run --directory backend --locked python ../scripts/test_backend.py --mysql",
    "preinstall": "node scripts/check-node-version.cjs",
    "build:web": "pnpm --filter @dayforge/frontend build",
    "db:up": "docker compose --env-file .env up -d --wait --wait-timeout 120 mysql",
    "db:down": "docker compose --env-file .env down",
    "db:migrate": "uv run --directory backend --locked --env-file .env alembic upgrade head",
    "db:current": "uv run --directory backend --locked --env-file .env alembic current",
    "dev:api": "uv run --directory backend --locked --env-file .env uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload --no-access-log",
    "dev:web": "pnpm --filter @dayforge/frontend dev",
    "setup:local": "uv run --directory backend --locked python ../scripts/init_local.py",
    "verify:env": "uv run --directory backend --locked python -m unittest discover -s ../scripts/tests -v",
    "start:web": "pnpm --filter @dayforge/frontend start",
    "smoke:local": "uv run --directory backend --locked python ../scripts/smoke_local.py"
  }
}
