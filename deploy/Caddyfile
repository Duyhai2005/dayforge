{
	admin off
	email {$ACME_EMAIL}
}

{$STAGING_ORIGIN} {
	encode zstd gzip
	@staging_maintenance file /run/dayforge/staging/on
	handle @staging_maintenance {
		header Retry-After 60
		respond "Temporarily unavailable" 503
	}
	handle {
		@staging_static path /_next/static/*
		handle @staging_static {
			reverse_proxy staging-web:3000 {
				@missing status 404
				handle_response @missing {
					reverse_proxy staging-web-previous:3000
				}
			}
		}
		reverse_proxy staging-web:3000
	}
}

{$PRODUCTION_ORIGIN} {
	encode zstd gzip
	@production_maintenance file /run/dayforge/production/on
	handle @production_maintenance {
		header Retry-After 60
		respond "Temporarily unavailable" 503
	}
	handle {
		@production_static path /_next/static/*
		handle @production_static {
			reverse_proxy production-web:3000 {
				@missing status 404
				handle_response @missing {
					reverse_proxy production-web-previous:3000
				}
			}
		}
		reverse_proxy production-web:3000
	}
}
