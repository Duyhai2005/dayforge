{
  "name": "@dayforge/frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "node ../scripts/check-local-api-origin.cjs",
    "dev": "next dev --hostname localhost --port 3000 --experimental-https --experimental-https-key ../.local/tls/localhost-key.pem --experimental-https-cert ../.local/tls/localhost.pem",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:prod": "cross-env PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001 playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3"
  }
}
